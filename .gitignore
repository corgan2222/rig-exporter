*.exe
*.exe~
reading.txt
probe.txt

# Editor settings are personal. They also made every build report itself as
# .dirty, because the build identifier asks git whether the tree is clean.
.vscode/
.code-review-graph
tmp/

# Working notes, kept on disk but out of the repository. The README is the
# documentation that ships; these are the project's memory for whoever
# continues it, and they are nobody else's business.
HANDOVER.md
maybe_later.md

fixes/
*.pem
!internal/updater/update-signing-cert.pem

# Built documentation site, produced by mkdocs from docs/.
site/

# Generated, not written: a docs plugin drops its processed script and style
# files into docs/ before every build. They belong to the build rather than to
# the source, the workflow regenerates them anyway, and checked in they would
# change on their own with every version bump of the plugin.
docs/assets/
tools/.image-api.key
